{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oceanfalls-new",
  "compatibility_date": "2026-03-30",
  "main": "index.js",
  "assets": {
    "directory": "."
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GOHIGHLEVEL_WEBHOOK_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oceanfalls-db",
      "database_id": "71cdd4b5-c647-4a2b-aaf7-b5515df70a84"
    }
  ]
}